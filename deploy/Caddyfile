# Caddy: HTTPS автоматически. Домен задаётся переменной окружения SITE_DOMAIN (например, evatoha.kg).
{$SITE_DOMAIN} {
	encode zstd gzip

	# API и админка PocketBase
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /_/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Статический сайт
	handle {
		root * /srv/eva-site/web/dist
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
