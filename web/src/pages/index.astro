---
import '../styles/global.css';
import snapshot from '../data/snapshot.json';

// `<` экранируем, чтобы данные из БД не могли закрыть тег <script>.
const snapshotJson = JSON.stringify(snapshot).replace(/</g, '\\u003c');
const shopName = snapshot.settings.shopName;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`${shopName}: EVA-коврики с пошивом канта вручную. Выберите цвета и закажите в WhatsApp.`}
    />
    <title>{shopName} — EVA-коврики для автомобиля</title>
  </head>
  <body>
    <div class="wrap">
      <header class="hero">
        <h1>{shopName}</h1>
        <p>EVA-коврики с кантом, которые мы режем и шьём вручную. Соберите свои цвета и отправьте заказ в WhatsApp.</p>
      </header>

      <section class="block" aria-label="Конфигуратор">
        <div id="configurator-root"></div>
      </section>

      <div id="sections-root"></div>

      <footer>© {shopName}</footer>
    </div>

    <script type="application/json" id="snapshot" set:html={snapshotJson} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
